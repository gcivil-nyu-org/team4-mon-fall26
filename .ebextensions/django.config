option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "playnyu.settings"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
  aws:elasticbeanstalk:container:python:
    WSGIPath: playnyu.wsgi:application
  # nginx serves collected static files (admin CSS etc.) directly
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
  # migrate runs as root, but gunicorn runs as the webapp user.
  # SQLite needs the file AND its folder to be writable by webapp, otherwise
  # writes fail with "attempt to write a readonly database".
  03_fix_permissions:
    command: "chown -R webapp:webapp ."
