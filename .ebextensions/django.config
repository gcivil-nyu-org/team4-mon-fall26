option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "playnyu.settings"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
  aws:elasticbeanstalk:container:python:
    WSGIPath: playnyu.wsgi:application
  # nginx serves collected static files (admin CSS etc.) directly
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
  # Create the admin user if it doesn't exist. On a persistent database, later deploys
  # find it already there; that error is ignored and the password is left unchanged.
  # Reads DJANGO_SUPERUSER_USERNAME, DJANGO_SUPERUSER_EMAIL and DJANGO_SUPERUSER_PASSWORD
  # (set with `eb setenv`). Skipped when they are not set; never fails the deploy.
  03_create_superuser:
    command: "source /var/app/venv/*/bin/activate && if [ -n \"$DJANGO_SUPERUSER_PASSWORD\" ]; then python manage.py createsuperuser --noinput || true; fi"
    leader_only: true
  # Same idea for one regular player account, so the site can be tested as a non-admin.
  # Reads TEST_PLAYER_EMAIL and TEST_PLAYER_PASSWORD; skipped when they are not set.
  # Runs before 04 so the database it writes is handed to webapp.
  03b_create_test_player:
    command: "source /var/app/venv/*/bin/activate && python manage.py create_test_player || true"
    leader_only: true
  # Fixed demo players (four captains, ten players) for demos and manual testing.
  # Reads DEMO_USERS_PASSWORD; skipped when it is not set.
  03c_seed_demo_users:
    command: "source /var/app/venv/*/bin/activate && python manage.py seed_demo_users || true"
    leader_only: true
  # Sports (required to create a team), then the facilities near NYU. Both are safe
  # to re-run on a persistent database. SEED_DEMO_SEASON is retired: when it is
  # still set, the command prints one line and creates no season.
  03d_seed_league_data:
    command: "source /var/app/venv/*/bin/activate && python manage.py seed_league_data || true"
    leader_only: true
  # This and next semester's season for every sport (open, then draft), with the
  # default divisions. Only adds missing seasons; never changes existing ones.
  03da_seed_semester_seasons:
    command: "source /var/app/venv/*/bin/activate && python manage.py seed_semester_seasons || true"
    leader_only: true
  03e_seed_facilities:
    command: "source /var/app/venv/*/bin/activate && python manage.py seed_facilities || true"
    leader_only: true
  # Demo teams and matches in this semester's seasons, for the testing site only.
  # Skipped unless SEED_DEMO_LEAGUE is set; do not set it on production. Needs the
  # demo players (03c), the seasons (03da) and the facilities (03e), so the key
  # must sort after 03e and before 04. Only adds what is missing.
  03f_seed_demo_league:
    command: "source /var/app/venv/*/bin/activate && python manage.py seed_demo_league || true"
    leader_only: true
  # migrate runs as root, but gunicorn runs as the webapp user.
  # Without DATABASE_URL the site uses SQLite, which needs the file AND its folder
  # to be writable by webapp, otherwise writes fail with
  # "attempt to write a readonly database".
  04_fix_permissions:
    command: "chown -R webapp:webapp ."
